{
  "name": "cwm-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "db:seed": "node scripts/generate-seed.mjs",
    "check": "npm run test && npm run build",
    "db:bundle": "node scripts/build-sql-editor.mjs",
    "db:legacy": "node scripts/build-legacy-upgrade.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "8.3.5",
    "pg": "8.16.3"
  }
}
